{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsxImportSource": "nativewind",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "index.ts", "App.tsx", "jest.setup.ts", "metro.config.js", "babel.config.js", "tailwind.config.js", "nativewind-env.d.ts"]
}
