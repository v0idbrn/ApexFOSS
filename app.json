{
  "expo": {
    "name": "ApexFOSS",
    "slug": "apexfoss",
    "version": "0.1.0",
    "scheme": "apexfoss",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020101",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#020101"
    },
    "android": {
      "package": "com.apexfoss.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#020101"
      }
    },
    "plugins": [
      "expo-notifications",
      "@morrowdigital/watermelondb-expo-plugin",
      "./plugins/withWatermelonJsiFix",
      "./plugins/withApexSigning",
      "./plugins/withNetworkHardening",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          },
          "ios": {
            "extraPods": [
              {
                "name": "simdjson",
                "configurations": ["Debug", "Release"],
                "path": "../node_modules/@nozbe/simdjson",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ]
  }
}
