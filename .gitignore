# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# CNG generated native projects (regenerated via `npx expo prebuild`).
# Anchored to repo root so fastlane/metadata/android stays committable.
/android/
/ios/

# Tooling installed locally (JDK, Android SDK) — never commit
.tooling/
local.properties
.freebuff/

# Keystores & secrets — NEVER commit
*.jks
*.keystore
!debug.keystore
keystore.properties
.env
.env.*

# Logs
npm-debug.*
yarn-error.log
*.log

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/

# User-provided routine payloads (personal training data) — kept on disk,
# never committed.
assets/*.apexroutine

# In-repo native module build outputs (rebuilt by Gradle, never committed).
modules/apex-notifications/android/build/
